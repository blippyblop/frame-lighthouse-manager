{
  "id": "com.blippyblop.LighthousePM",
  "name": "Lighthouse Power Manager",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-version": "24.08",
  "base": "org.freedesktop.Platform",
  "base-version": "24.08",
  "appstream-compat": false,
  "separate-locales": false,
  "modules": [
    {
      "name": "lighthouse-pm",
      "buildsystem": "simple",
      "build-commands": [],
      "sources": [
        {
          "type": "dir",
          "path": "staged/app"
        }
      ]
    }
  ],
  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--socket=x11",
    "--socket=fallback",
    "--socket=session-bus",
    "--device=dri"
  ]
}
